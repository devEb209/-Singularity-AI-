name: SNB Browser E2E
on:
  workflow_dispatch:
  pull_request:
permissions:
  contents: read
jobs:
  chromium:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npx playwright install --with-deps chromium
      - run: npm run secrets:generate
      - name: Start SNB
        run: |
          npm run start:api > api.log 2>&1 &
          npm run start:worker > worker.log 2>&1 &
          npm run dev -- --host 0.0.0.0 --port 4173 > web.log 2>&1 &
          for i in {1..60}; do curl -fsS http://127.0.0.1:4173/api/health && exit 0; sleep 1; done
          cat api.log web.log worker.log
          exit 1
      - run: npm run e2e
      - if: always()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: |
            playwright-report/
            test-results/
            *.log
          if-no-files-found: ignore
