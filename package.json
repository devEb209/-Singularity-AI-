{
  "name": "singularity-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "dev:worker": "tsx watch server/worker.ts",
    "start:worker": "tsx server/worker.ts",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "models:import": "tsx scripts/import-puter-models.ts",
    "secrets:generate": "tsx scripts/generate-local-env.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:verify": "tsx scripts/backup.ts verify",
    "v1:report": "tsx scripts/generate-v1-readiness.ts",
    "sbom:generate": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run typecheck:api && npm run build",
    "beta:check": "npm run check && npm audit --omit=dev",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fflate": "^0.8.2",
    "jose": "^6.2.10",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tsx": "^4.23.12",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
