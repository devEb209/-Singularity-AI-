NODE_ENV=development
HOST=0.0.0.0
PORT=8787
CORS_ORIGIN=http://localhost:4173,http://127.0.0.1:4173
PUBLIC_BASE_URL=http://localhost:4173
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./data/singularity.db
MAX_UPLOAD_BYTES=26214400
MODEL_SYNC_SECRET=replace-with-an-independent-32-character-secret
EXECUTION_RECEIPT_SECRET=replace-with-an-independent-receipt-secret
PHYSICAL_EXECUTION_ENABLED=false
WORKER_SECRET=replace-with-an-independent-worker-secret
WORKER_LEASE_SECONDS=30
WORKER_POLL_MS=1000
EXTERNAL_PROVIDER_CONFIG=./data/providers.json

# Optional OpenAI-compatible provider (OpenAI, local gateway, or another compatible API)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=singularity-main
LOG_LEVEL=info
